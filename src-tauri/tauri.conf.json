{
  "$schema": "https://raw.githubusercontent.com/nicegui/multi-user-tailwindcss/refs/heads/main/src-tauri/schemas/desktop-schema.json",
  "productName": "rust-win-tool",
  "version": "0.1.0",
  "identifier": "com.example.rust-win-tool",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rust Win Tool",
        "width": 1000,
        "height": 660,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
